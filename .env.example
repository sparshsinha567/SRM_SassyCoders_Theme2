# Copy this file to .env and fill in your real key.
# If left unset, the pipeline runs on a free, deterministic stub LLM
# (see llm_client.py) -- useful for development and reproducibility at $0.00 cost.
# Configure one of the providers below:

# 1. Google Gemini (recommended - fast and low cost)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 3. OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

